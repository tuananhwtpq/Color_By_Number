<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layoutDirection="ltr">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardRealm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="64dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_realm_item_gradient">

            <TextView
                android:id="@+id/tvRealmName"
                style="@style/Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="10dp"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/grey_700"
                app:layout_constraintEnd_toStartOf="@id/ivSelector"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Sakura Haven" />

            <ImageView
                android:id="@+id/ivSelector"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/bg_oval_selector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivRealmThumbnail"
                android:layout_width="0dp"
                android:layout_height="184dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_realm_thumbnail_clip"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvRealmName"
                tools:src="@drawable/sakura_haven_thumbnail" />

            <ImageView
                android:id="@+id/tvViewUnlock"
                style="@style/ButtonM"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:elevation="6dp"
                android:src="@drawable/ic_eye_open"
                app:layout_constraintBottom_toBottomOf="@id/ivRealmThumbnail"
                app:layout_constraintEnd_toEndOf="@id/ivRealmThumbnail" />

            <TextView
                android:id="@+id/tvViewLock"
                style="@style/ButtonS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_gradient"
                android:elevation="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                android:text="@string/unlock"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="@id/ivRealmThumbnail"
                app:layout_constraintEnd_toEndOf="@id/ivRealmThumbnail" />

            <View
                android:id="@+id/lockedScrim"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_realm_locked_scrim"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="gone" />

            <ImageView
                android:id="@+id/ivLockBadge"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="8dp"
                android:src="@drawable/ic_lock_full"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/lockProgressContainer"
                app:layout_constraintEnd_toEndOf="@id/ivRealmThumbnail"
                app:layout_constraintStart_toStartOf="@id/ivRealmThumbnail"
                app:layout_constraintTop_toTopOf="@id/ivRealmThumbnail"
                app:layout_constraintVertical_chainStyle="packed"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/lockProgressContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_library_category_tab_unselected"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ivRealmThumbnail"
                app:layout_constraintEnd_toEndOf="@id/ivRealmThumbnail"
                app:layout_constraintStart_toStartOf="@id/ivRealmThumbnail"
                app:layout_constraintTop_toBottomOf="@id/ivLockBadge"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvCollectedDrops"
                    style="@style/BodyM"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/grey_200"
                    tools:text="Collected 2/10 Paint Drops" />

                <TextView
                    android:id="@+id/tvMoreToUnlock"
                    style="@style/BodyS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/white"
                    tools:text="8 more to unlock" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/ivDownArrow"
        android:layout_width="48dp"
        android:layout_height="72dp"
        android:layout_marginTop="18dp"
        android:src="@drawable/ic_down_arrow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardRealm"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
