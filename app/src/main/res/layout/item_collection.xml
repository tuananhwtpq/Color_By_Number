<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp">

    <ImageView
        android:id="@+id/ivThumbnail"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_corner_100dp"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@color/black" />

    <ImageView
        android:id="@+id/ivMiniImage"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:elevation="4dp"
        android:src="@drawable/ic_black_mini_image"
        app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvNumberCount"
        style="@style/sub2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_50_percent"
        android:paddingVertical="6dp"
        android:paddingStart="44dp"
        android:paddingEnd="12dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="@id/ivMiniImage"
        app:layout_constraintStart_toStartOf="@id/ivMiniImage"
        app:layout_constraintTop_toTopOf="@id/ivMiniImage"
        tools:text="2" />


</androidx.constraintlayout.widget.ConstraintLayout>