<?xml version="1.0" encoding="utf-8"?>
<!--
  Cả màn hình cuộn chung trong một NestedScrollView. rvLevels bên dưới KHÔNG tự cuộn
  (height=wrap_content + nestedScrollingEnabled=false) để tránh hai vùng cuộn lồng nhau:
  RecyclerView trải hết chiều cao và NestedScrollView là thứ duy nhất cuộn.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_full_main_theme_01"
    android:fillViewport="true"
    tools:context=".activities.CollectionDetailActivity"
    android:layoutDirection="ltr">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_oval_trans"
            android:padding="8dp"
            android:src="@drawable/ic_left_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_corner_100dp"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            tools:src="@color/black" />

        <ImageView
            android:id="@+id/ivMiniImage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp"
            android:src="@drawable/ic_black_mini_image"
            app:layout_constraintBottom_toBottomOf="@id/ivThumbnail"
            app:layout_constraintStart_toStartOf="@id/ivThumbnail" />

        <TextView
            android:id="@+id/tvNumberCount"
            style="@style/sub2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_50_percent"
            android:paddingVertical="6dp"
            android:paddingStart="44dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/ivMiniImage"
            app:layout_constraintStart_toStartOf="@id/ivMiniImage"
            app:layout_constraintTop_toTopOf="@id/ivMiniImage"
            tools:text="2" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/Heading1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivThumbnail"
            tools:text="Lunar New Year" />

        <TextView
            android:id="@+id/tvDescription"
            style="@style/BodyL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/grey_200"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            tools:text="Celebrate Lunar New Year through colorful traditions from around the world."
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/ivMiniImage02"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:elevation="4dp"
            android:src="@drawable/ic_mini_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

        <TextView
            android:id="@+id/tvNumberCountDone"
            style="@style/sub2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_white_20_percent"
            android:paddingVertical="6dp"
            android:paddingStart="50dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/ivMiniImage02"
            app:layout_constraintStart_toStartOf="@id/ivMiniImage02"
            app:layout_constraintTop_toTopOf="@id/ivMiniImage02"
            tools:text="2/10" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLevels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/ivMiniImage02"
            tools:itemCount="4"
            tools:listitem="@layout/item_level" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivMiniImage02" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
