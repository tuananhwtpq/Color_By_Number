<?xml version="1.0" encoding="utf-8"?>
<!--
    Nền trắng 20% + viền trắng. Shape drawable của Android KHÔNG hỗ trợ stroke đổ gradient,
    nên viền dùng thẳng #B2FFFFFF (mốc 70% giữa dải gradient trong design). Cách xen 2 lớp
    như bg_library_category_tab_selected không dùng được ở đây vì lớp fill là bán trong suốt
    (20%), lớp gradient bên dưới sẽ lộ qua và làm sáng cả phần ruột.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="20dp" />
    <solid android:color="#33FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#B2FFFFFF" />
</shape>
